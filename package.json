{
	"name": "hcc",
	"version": "0.4.0",
	"description": "Interactive terminal interface for the headlesscode coding-agent harness.",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"hcc": "bin/hcc.mjs"
	},
	"scripts": {
		"start": "tsx src/cli.ts",
		"test": "tsx --test test/*.test.ts",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"lint": "prettier --check ."
	},
	"dependencies": {
		"headlesscode": "file:../headlesscode",
		"tsx": "^4.20.3"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"prettier": "^3.6.2",
		"typescript": "^5.9.2"
	}
}
